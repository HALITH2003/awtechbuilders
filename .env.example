# ==========================================
# Aw Marketplace Environment Configuration
# ==========================================

# Server Configuration
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Database Connection (PostgreSQL)
# Local Docker: postgresql://aw_user:aw_password@localhost:5432/aw_db?schema=public
# Supabase: postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
DATABASE_URL=postgresql://aw_user:aw_password@localhost:5432/aw_db?schema=public

# Authentication & Security
# Generate a strong 256-bit random key in production
JWT_SECRET=super_secret_jwt_key_change_in_production_aw_marketplace_2026
JWT_EXPIRES_IN=7d

# Development Modes
# Set OTP_MODE=mock for development (allows code 123456 or logged OTP)
OTP_MODE=mock

# Set PAYMENT_MODE=mock for local testing (simulates instant payments)
PAYMENT_MODE=mock

# Storage Provider: 'local' (saves to backend/uploads) or 's3' (AWS S3 / Supabase Storage)
STORAGE_PROVIDER=local
STORAGE_BUCKET=aw-marketplace-uploads
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# Email Service Provider: 'mock' (logs to console) or 'smtp' / 'sendgrid'
EMAIL_PROVIDER=mock
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=no-reply@awmarketplace.lk

# SMS Service Provider: 'mock' or 'twilio'
SMS_PROVIDER=mock
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Business Constants
PLATFORM_FEE_PERCENT=10
COIN_EXCHANGE_RATE_LKR=20
PROJECT_POSTING_COIN_COST=2
PROPOSAL_SUBMISSION_COIN_COST=2
